# Copy to .env and fill in. Never commit .env (CLAUDE.md conventions).
#
# Note the shape of this file: no bundler or paymaster API keys appear here.
# Those live only in the proxy (ARCHITECTURE.md §7) and must never be present
# in the app binary, where they are trivially extracted.

# Base URL of the stateless proxy that holds provider API keys.
# The app must remain able to fall back to a public bundler if this is
# unreachable — that fallback is what keeps Invariant 7 true, and it is tested.
BLIN_PROXY_URL=http://localhost:8787

# Chain to target. Testnet only until after external audit (decision 4).
BLIN_CHAIN_ID=84532
